<h1>Trade #<%= @trade.id %></h1>

<p>
  <strong>Proposer:</strong> <%= @trade.proposer.name.presence || @trade.proposer.email %><br>
  <strong>Recipient:</strong> <%= @trade.recipient.name.presence || @trade.recipient.email %><br>
  <strong>Status:</strong> <span class="badge bg-secondary"><%= @trade.status %></span>
</p>

<div class="row">
  <div class="col-md-6">
    <h3>Offered by Proposer</h3>
    <% @trade.trade_items.where(side: "proposer").includes(:unitard).each do |ti| %>
      <p><%= link_to ti.unitard.name, ti.unitard %></p>
    <% end %>
  </div>

  <div class="col-md-6">
    <h3>Requested from Recipient</h3>
    <% @trade.trade_items.where(side: "recipient").includes(:unitard).each do |ti| %>
      <p><%= link_to ti.unitard.name, ti.unitard %></p>
    <% end %>
  </div>
</div>

<% if current_user.id == @trade.recipient_id && @trade.status == "pending" %>
  <div class="button-row mt-3">
    <%= button_to "Accept Trade",
                  trade_path(@trade, decision: :accept),
                  method: :patch,
                  class: "btn btn-success" %>

    <%= button_to "Reject Trade",
                  trade_path(@trade, decision: :reject),
                  method: :patch,
                  class: "btn btn-outline-danger" %>
  </div>
<% end %>

<p class="mt-3">
  <%= link_to "Back to Trades", trades_path, class: "btn btn-link" %>
</p>
