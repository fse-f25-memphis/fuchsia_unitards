<h1>Propose Trade</h1>

<%= form_with model: @trade, url: trades_path, local: true do |f| %>
  <div class="mb-3">
    <%= f.label :recipient_id, "Select trade partner" %>
    <%= f.collection_select :recipient_id,
          User.where.not(id: current_user.id),
          :id, :email,
          { prompt: "Choose user..." },
          { class: "form-select" } %>
  </div>

  <div class="row">
    <div class="col-md-6">
      <h3>Your Unitards (offered)</h3>
      <% @owned_unitards.each do |u| %>
        <div class="form-check">
          <%= check_box_tag "proposer_unitard_ids[]", u.id, false, class: "form-check-input", id: "prop_#{u.id}" %>
          <%= label_tag "prop_#{u.id}", "#{u.name} (#{u.size}, #{u.color})", class: "form-check-label" %>
        </div>
      <% end %>
    </div>

    <div class="col-md-6">
      <h3>Desired Unitards (from recipient)</h3>
      <p class="text-muted">
        (Later you can restrict this to unitards that the recipient marked as "available for trade".)
      </p>
      <div class="mb-2">
        <%= text_field_tag "recipient_unitard_ids[]", nil,
              class: "form-control",
              placeholder: "Enter desired unitard IDs, one per line/field" %>
      </div>
    </div>
  </div>

  <%= f.submit "Send Trade Proposal", class: "btn btn-primary mt-3" %>
<% end %>
