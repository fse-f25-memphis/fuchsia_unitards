<h1>Shopping Cart</h1>

<% if @cart.cart_items.any? %>
  <div class="row">
    <div class="col-md-8">
      <% @cart.cart_items.includes(:unitard).each do |item| %>
        <div class="card cart-item-card">
          <div class="row">
          <div class="col-md-3 cart-item-icon">
          <%= image_tag unitard_image(item.unitard),
                        alt: item.unitard.name,
                        class: "cart-unitard-image" %>
        </div>
        
            <div class="col-md-9">
              <div class="card-body">
                <h5 class="card-title">
                  <%= link_to item.unitard.name, item.unitard %>
                </h5>
                <p class="card-text mb-1">
                  <strong>Price:</strong>
                  <%= number_to_currency(item.unitard.price) %>
                </p>
                <p class="card-text mb-1">
                  <small>
                    <%= item.unitard.cut %> |
                    <%= item.unitard.size %> |
                    <%= item.unitard.color %>
                  </small>
                </p>

                <div class="button-row mt-2">
                  <%= form_with model: item,
                                url: update_item_cart_path(item),
                                method: :patch,
                                local: true,
                                class: "inline-form" do |f| %>
                    <%= f.label :quantity, "Qty:", class: "mb-0" %>
                    <%= f.number_field :quantity, min: 1, class: "form-control qty-input" %>
                    <%= f.submit "Update", class: "btn btn-outline-primary btn-sm" %>
                  <% end %>

                  <%= button_to "Remove",
                                remove_item_cart_path(item),
                                method: :delete,
                                data: { confirm: "Remove this unitard from your cart?" },
                                class: "btn btn-outline-danger btn-sm" %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-4">
      <div class="card order-summary-card">
        <div class="card-body">
          <h4>Order Summary</h4>
          <% total = @cart.cart_items.includes(:unitard).sum { |i| i.quantity * i.unitard.price } %>
          <p class="fs-5">
            <strong>Total:</strong> <%= number_to_currency(total) %>
          </p>
          <%= link_to "Proceed to Checkout",
                      new_order_path,
                      class: "btn btn-primary w-100" %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <p>Your cart is empty.</p>
  <%= link_to "Browse Unitards", unitards_path, class: "btn btn-primary" %>
<% end %>
