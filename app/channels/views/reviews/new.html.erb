<h1>Write a Review for <%= @unitard.name %></h1>

<%= form_with model: [@unitard, @review], local: true do |f| %>
  <div class="mb-3">
    <%= f.label :rating, "Rating (1–5)" %>
    <%= f.number_field :rating, in: 1..5, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :comment, "Your review" %>
    <%= f.text_area :comment, rows: 4, class: "form-control" %>
  </div>

  <%= f.submit "Submit Review", class: "btn btn-primary" %>
<% end %>

<p class="mt-3">
  <%= link_to "Back to Unitard", @unitard, class: "btn btn-link" %>
</p>
