<h1>Support Ticket #<%= @ticket.id %></h1>

<p>
  <strong>Subject:</strong> <%= @ticket.subject %><br>
  <strong>Status:</strong> <span class="badge bg-secondary"><%= @ticket.status %></span>
</p>

<p><%= simple_format(@ticket.message) %></p>

<p class="mt-3">
  <%= link_to "Back to Home", root_path, class: "btn btn-link" %>
</p>
