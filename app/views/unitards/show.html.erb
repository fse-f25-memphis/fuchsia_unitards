<div class="row">
  <div class="col-md-6">
  <div class="product-hero">
  <div class="product-hero-inner">
    <%= image_tag unitard_image(@unitard),
                  alt: @unitard.name,
                  class: "unitard-show-image" %>

    <h2><%= @unitard.name %></h2>
    <p class="text-muted mb-0">Masters of the Universe Edition</p>
  </div>
</div>

  </div>

  <div class="col-md-6">
    <h1><%= @unitard.name %></h1>

    <p class="lead">
      <strong><%= number_to_currency(@unitard.price) %></strong>
    </p>

    <ul class="list-unstyled mb-3">
      <li><strong>Cut:</strong> <%= @unitard.cut.presence || "N/A" %></li>
      <li><strong>Size:</strong> <%= @unitard.size.presence || "N/A" %></li>
      <li><strong>Sleeves:</strong> <%= @unitard.sleeves.presence || "N/A" %></li>
      <li><strong>Graphic:</strong> <%= @unitard.graphic.presence || "N/A" %></li>
      <li><strong>Color:</strong> <%= @unitard.color.presence || "N/A" %></li>
      <li><strong>Stock:</strong> <%= @unitard.stock %> available</li>
    </ul>

    <% if @unitard.special_features.present? %>
      <p><strong>Special Features:</strong> <%= @unitard.special_features %></p>
    <% end %>

    <% if @unitard.description.present? %>
      <p><%= simple_format(@unitard.description) %></p>
    <% end %>

    <% if user_signed_in? %>
      <div class="button-row mt-3">
        <%= button_to "Add to Cart",
                      add_to_cart_path(unitard_id: @unitard.id),
                      method: :post,
                      class: "btn btn-primary" %>

        <%= button_to "Toggle Wishlist",
                      toggle_wishlist_unitard_path(@unitard),
                      method: :post,
                      class: "btn btn-outline-secondary" %>

        <%= link_to "Write Review",
                    new_unitard_review_path(@unitard),
                    class: "btn btn-outline-primary" %>
      </div>
    <% else %>
      <p class="mt-3">
        <%= link_to "Sign in", new_user_session_path %> to add this unitard to your cart or wishlist.
      </p>
    <% end %>

    <p class="mt-4">
      <%= link_to "Back to Unitards", unitards_path, class: "btn btn-link" %>
    </p>
  </div>
</div>

<hr>

<h3>Reviews</h3>
<% if @unitard.reviews.any? %>
  <% @unitard.reviews.each do |review| %>
    <div class="review-card">
      <strong><%= review.user.name.presence || review.user.email %></strong>
      <span class="review-stars"><%= "⭐" * review.rating %></span>
      <p class="mb-0"><%= review.comment %></p>
    </div>
  <% end %>
<% else %>
  <p>No reviews yet.</p>
<% end %>
