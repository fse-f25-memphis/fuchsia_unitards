<h1 class="page-title">Masters of the Unitard</h1>

<div class="search-container mb-4">
  <%= form_with url: unitards_path, method: :get, local: true, html: { class: "row g-2 align-items-end" } do %>
    <div class="col-md-4">
      <%= label_tag :query, "Search" %>
      <%= text_field_tag :query, params[:query], class: "form-control", placeholder: "Search unitards..." %>
    </div>

    <div class="col-md-2">
      <%= label_tag :size, "Size" %>
      <%= select_tag :size,
          options_for_select(["", "S", "M", "L", "XL", "XXL", "XXXL"], params[:size]),
          class: "form-select" %>
    </div>

    <div class="col-md-2">
      <%= label_tag :color, "Color" %>
      <%= text_field_tag :color, params[:color], class: "form-control", placeholder: "e.g. Red" %>
    </div>

    <div class="col-md-2">
      <%= label_tag :sort, "Sort" %>
      <%= select_tag :sort,
          options_for_select([
            ["Price: Low → High", "price_asc"],
            ["Price: High → Low", "price_desc"]
          ], params[:sort]),
          include_blank: "Choose…",
          class: "form-select" %>
    </div>

    <div class="col-md-2">
    <div class="col-md-2">
  <%= label_tag :actions, "Apply" %>

  <div class="d-flex gap-2">
    <%= submit_tag "Apply", class: "btn btn-primary w-100" %>

    <% if params[:query].present? || params[:size].present? || params[:color].present? || params[:sort].present? %>
    <%= link_to "Clear Filter",
                  unitards_path,
                  class: "btn btn-outline-secondary w-100" %>
    <% end %>
  </div>
</div>

  <% end %>
</div>

<% if @unitards.any? %>
  <div class="row cards-grid">
    <% @unitards.each do |unitard| %>
      <div class="col-md-4">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to unitard.name, unitard_path(unitard) %>
            </h5>
            <p class="card-text">
              <strong><%= number_to_currency(unitard.price) %></strong><br>
              <small>
                <%= unitard.cut %> |
                <%= unitard.size %> |
                <%= unitard.color %>
              </small>
            </p>
            <% if unitard.description.present? %>
              <p class="card-text text-muted">
                <%= truncate(unitard.description, length: 80) %>
              </p>
            <% end %>
          </div>
          <div class="card-footer card-footer-actions action-buttons">
  <%= link_to "View", unitard_path(unitard), class: "btn btn-outline-primary btn-sm" %>

  <% if user_signed_in? %>
    <%= button_to "Add to Cart",
                  add_to_cart_path(unitard_id: unitard.id),
                  method: :post,
                  class: "btn btn-primary btn-sm d-inline-block" %>
  <% end %>
</div>

        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p>No unitards found. Try changing your filters.</p>
<% end %>
