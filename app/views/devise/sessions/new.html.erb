<div class="auth-container">
<div class="auth-card">
<div class="auth-header">
<h2>Welcome Back</h2>
<p class="auth-subtitle">Sign in to your UniVerse account</p>
</div>
 
    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
<div class="auth-body">
<div class="form-field">
<%= f.label :email, "📧 Email" %>
<%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "your@email.com" %>
</div>
 
        <div class="form-field">
<%= f.label :password, "🔒 Password" %>
<%= f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Enter your password" %>
</div>
 
        <% if devise_mapping.rememberable? %>
<div class="form-check-field">
<%= f.check_box :remember_me, class: "form-check-input" %>
<%= f.label :remember_me, class: "form-check-label" %>
</div>
<% end %>
 
        <div class="form-actions">
<%= f.submit "Log in", class: "btn btn-primary btn-full" %>
</div>
</div>
<% end %>
 
    <div class="auth-footer">
<%= render "devise/shared/links" %>
</div>
</div>
</div>