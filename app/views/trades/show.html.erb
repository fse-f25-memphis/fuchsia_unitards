<div class="container">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 class="page-title" style="margin-bottom: 0;">Trade #<%= @trade.id %></h1>
    <%= link_to "← Back to Trades", trades_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-body">
      <div class="row">
        <div class="col-md-4">
          <p style="margin-bottom: 0.5rem;">
            <strong style="color: var(--text-gray); font-size: 0.875rem;">Proposer:</strong><br>
            <span style="font-size: 1.1rem;"><%= @trade.proposer.name.presence || @trade.proposer.email %></span>
          </p>
        </div>
        <div class="col-md-4">
          <p style="margin-bottom: 0.5rem;">
            <strong style="color: var(--text-gray); font-size: 0.875rem;">Recipient:</strong><br>
            <span style="font-size: 1.1rem;"><%= @trade.recipient.name.presence || @trade.recipient.email %></span>
          </p>
        </div>
        <div class="col-md-4">
          <p style="margin-bottom: 0.5rem;">
            <strong style="color: var(--text-gray); font-size: 0.875rem;">Status:</strong><br>
            <% 
              status_colors = {
                'pending' => '#f59e0b',
                'accepted' => '#10b981',
                'rejected' => '#ef4444',
                'cancelled' => '#6b7280'
              }
              status_color = status_colors[@trade.status] || '#6b7280'
            %>
            <span style="display: inline-block; padding: 0.5rem 1rem; background: <%= status_color %>; color: white; border-radius: 12px; font-weight: 600; font-size: 1rem;">
              <%= @trade.status.capitalize %>
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Proposer Actions: Modify or Cancel (only for pending trades) -->
  <% if current_user.id == @trade.proposer_id && @trade.status == "pending" %>
    <div class="card" style="margin-bottom: 2rem; border: 2px solid var(--primary-purple);">
      <div class="card-body">
        <h4 style="margin-bottom: 1rem;">Your Trade Actions</h4>
        <div style="display: flex; gap: 1rem;">
          <%= link_to "Modify Trade", edit_trade_path(@trade), class: "btn btn-primary" %>
          <%= button_to "Cancel Trade",
                        cancel_trade_path(@trade),
                        method: :patch,
                        class: "btn btn-outline-danger",
                        data: { turbo_confirm: "Are you sure you want to cancel this trade?" } %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-6">
      <div class="card" style="height: 100%;">
        <div class="card-body">
          <h3 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: var(--primary-purple);">
            Offered by <%= @trade.proposer.name.presence || 'Proposer' %>
          </h3>
          <% proposer_items = @trade.trade_items.where(side: "proposer").includes(:unitard) %>
          <% if proposer_items.any? %>
            <% proposer_items.each do |ti| %>
              <div style="padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 0.75rem;">
                <%= link_to ti.unitard.name, ti.unitard, style: "color: var(--text-dark); font-weight: 500; text-decoration: none;" %>
                <br>
                <small style="color: var(--text-gray);"><%= ti.unitard.size %> | <%= ti.unitard.color %></small>
              </div>
            <% end %>
          <% else %>
            <p style="color: var(--text-gray);">No items offered</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-md-6">
      <div class="card" style="height: 100%;">
        <div class="card-body">
          <h3 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: var(--secondary-pink);">
            Requested from <%= @trade.recipient.name.presence || 'Recipient' %>
          </h3>
          <% recipient_items = @trade.trade_items.where(side: "recipient").includes(:unitard) %>
          <% if recipient_items.any? %>
            <% recipient_items.each do |ti| %>
              <div style="padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 0.75rem;">
                <%= link_to ti.unitard.name, ti.unitard, style: "color: var(--text-dark); font-weight: 500; text-decoration: none;" %>
                <br>
                <small style="color: var(--text-gray);"><%= ti.unitard.size %> | <%= ti.unitard.color %></small>
              </div>
            <% end %>
          <% else %>
            <p style="color: var(--text-gray);">No items requested</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Recipient Actions: Accept or Reject -->
  <% if current_user.id == @trade.recipient_id && @trade.status == "pending" %>
    <div class="card" style="margin-top: 2rem; border: 2px solid var(--primary-purple);">
      <div class="card-body">
        <h4 style="margin-bottom: 1rem;">Respond to Trade Proposal</h4>
        <div style="display: flex; gap: 1rem;">
          <%= button_to "Accept Trade",
                        trade_path(@trade, decision: :accept),
                        method: :patch,
                        class: "btn btn-primary",
                        style: "background: linear-gradient(135deg, #10b981, #059669);" %>

          <%= button_to "Reject Trade",
                        trade_path(@trade, decision: :reject),
                        method: :patch,
                        class: "btn btn-outline-danger",
                        data: { turbo_confirm: "Are you sure you want to reject this trade?" } %>
        </div>
      </div>
    </div>
  <% end %>
</div>