<div class="container">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h1 class="page-title" style="margin-bottom: 0;">Order #<%= @order.id %></h1>
    <%= link_to "← Back to Orders", orders_path, class: "btn btn-outline-secondary" %>
  </div>

  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <p style="margin-bottom: 0.5rem;">
            <strong style="color: var(--text-gray); font-size: 0.875rem;">Placed on:</strong><br>
            <span style="font-size: 1.1rem;"><%= @order.created_at.strftime("%B %d, %Y") %></span>
          </p>
        </div>
        <div class="col-md-3">
          <p style="margin-bottom: 0.5rem;">
            <strong style="color: var(--text-gray); font-size: 0.875rem;">Status:</strong><br>
            <% 
              status_colors = {
                'pending' => '#f59e0b',
                'paid' => '#3b82f6',
                'shipped' => '#8b5cf6',
                'completed' => '#10b981',
                'cancelled' => '#ef4444'
              }
              status_color = status_colors[@order.status] || '#6b7280'
            %>
            <span style="display: inline-block; padding: 0.5rem 1rem; background: <%= status_color %>; color: white; border-radius: 12px; font-weight: 600; font-size: 1rem;">
              <%= @order.status.capitalize %>
            </span>
          </p>
        </div>
        <div class="col-md-3">
          <p style="margin-bottom: 0.5rem;">
            <strong style="color: var(--text-gray); font-size: 0.875rem;">Tracking Number:</strong><br>
            <% if @order.tracking_number.present? %>
              <span style="font-size: 1rem; font-weight: 600; color: var(--primary-purple); font-family: monospace;">
                <%= @order.tracking_number %>
              </span>
            <% else %>
              <span style="color: var(--text-gray);">N/A</span>
            <% end %>
          </p>
        </div>
        <div class="col-md-3">
          <p style="margin-bottom: 0.5rem;">
            <strong style="color: var(--text-gray); font-size: 0.875rem;">Total:</strong><br>
            <span style="font-size: 1.5rem; font-weight: 700; color: var(--primary-purple);"><%= number_to_currency(@order.total) %></span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <% if @order.gift? %>
    <div class="alert alert-info" style="background: linear-gradient(135deg, #dbeafe, #bfdbfe); border-left: 4px solid #3b82f6; padding: 1.5rem; border-radius: 12px; margin-bottom: 2rem;">
      <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">🎁</div>
      <strong>Gift Order</strong><br>
      Sent to <strong><%= @order.recipient_name %></strong> (<%= @order.recipient_email %>)
      <% if @order.gift_message.present? %>
        <br><br>
        <em style="color: #1e40af;">"<%= @order.gift_message %>"</em>
      <% end %>
    </div>
  <% end %>

  <div class="card" style="margin-bottom: 2rem;">
    <div class="card-body">
      <h3 style="margin-bottom: 1.5rem; font-size: 1.25rem;">Order Items</h3>

      <table style="width: 100%; border-collapse: collapse;">
        <thead style="background: linear-gradient(135deg, #fafafa, #f3f4f6); border-bottom: 2px solid var(--border-color);">
          <tr>
            <th style="padding: 1rem; text-align: left; font-weight: 600;">Unitard</th>
            <th style="padding: 1rem; text-align: left; font-weight: 600;">Quantity</th>
            <th style="padding: 1rem; text-align: left; font-weight: 600;">Price</th>
            <th style="padding: 1rem; text-align: left; font-weight: 600;">Subtotal</th>
          </tr>
        </thead>
        <tbody>
          <% @order.order_items.includes(:unitard).each do |item| %>
            <tr style="border-bottom: 1px solid var(--border-color);">
              <td style="padding: 1rem;">
                <%= link_to item.unitard.name, item.unitard, style: "color: var(--primary-purple); font-weight: 600;" %>
              </td>
              <td style="padding: 1rem;"><%= item.quantity %></td>
              <td style="padding: 1rem;"><%= number_to_currency(item.price) %></td>
              <td style="padding: 1rem; font-weight: 600;"><%= number_to_currency(item.price * item.quantity) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Write Review Section (Only for Completed Orders) -->
  <% if @order.status == "completed" %>
    <div class="card" style="border: 2px solid #10b981;">
      <div class="card-body">
        <h3 style="margin-bottom: 1.5rem; font-size: 1.25rem; color: #10b981;">✍️ Write a Review</h3>

        <% @order.order_items.includes(:unitard).each do |item| %>
          <div style="padding: 1.5rem; background: #f9fafb; border-radius: 12px; margin-bottom: 1.5rem;">
            <h5 style="margin-bottom: 1rem; font-size: 1.1rem; font-weight: 600;">
              <%= item.unitard.name %>
            </h5>

            <%= form_with url: reviews_path, method: :post, local: true do |f| %>
              <%= f.hidden_field :unitard_id, value: item.unitard.id %>
              <%= f.hidden_field :order_id, value: @order.id %>

              <div style="margin-bottom: 1rem;">
                <%= f.label :rating, "Rating:", style: "display: block; font-weight: 600; margin-bottom: 0.5rem;" %>
                <%= f.select :rating, (1..5).map { |i| ["#{'★' * i} (#{i} stars)", i] }, { prompt: "Select rating..." }, class: "form-control", style: "width: 100%; padding: 0.5rem;" %>
              </div>

              <div style="margin-bottom: 1rem;">
                <%= f.label :title, "Review Title:", style: "display: block; font-weight: 600; margin-bottom: 0.5rem;" %>
                <%= f.text_field :title, class: "form-control", placeholder: "Sum up your experience", style: "width: 100%;" %>
              </div>

              <div style="margin-bottom: 1rem;">
                <%= f.label :comment, "Your Review:", style: "display: block; font-weight: 600; margin-bottom: 0.5rem;" %>
                <%= f.text_area :comment, rows: 4, class: "form-control", placeholder: "Share your thoughts about this unitard", style: "width: 100%;" %>
              </div>

              <%= f.submit "Submit Review", class: "btn btn-primary", style: "background: linear-gradient(135deg, #10b981, #059669); border: none;" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>