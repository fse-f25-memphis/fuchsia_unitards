<h1>My Orders</h1>

<% if @orders.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Order #</th>
        <th>Date</th>
        <th>Status</th>
        <th>Total</th>
        <th>Gift?</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= order.id %></td>
          <td><%= order.created_at.strftime("%Y-%m-%d") %></td>
          <td><span class="badge bg-secondary"><%= order.status %></span></td>
          <td><%= number_to_currency(order.total) %></td>
          <td><%= order.gift? ? "🎁" : "-" %></td>
          <td><%= link_to "View", order_path(order), class: "btn btn-outline-primary btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>You have no orders yet.</p>
<% end %>
